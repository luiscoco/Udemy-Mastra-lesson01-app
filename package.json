{
  "name": "udemy-mastra-lesson01-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lesson 1: a document-grounded Mastra tutor with five guided student pages",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "build:pages": "tsx scripts/build-pages.ts",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run build:pages && npm run build:client",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test tests/*.test.ts",
    "sample": "tsx --env-file-if-exists=.env src/sample.ts",
    "search": "tsx src/sample.ts --search"
  },
  "dependencies": {
    "@mastra/core": "1.81.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
